{
  "name": "totally-real-mem",
  "version": "1.0.0",
  "description": "Mock calculator company backend for shared-memory agent testing.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "mcp:sync": "uv --directory mcp sync",
    "mcp:run": "uv --directory mcp run server.py",
    "mcp:inspect": "npx @modelcontextprotocol/inspector uv --directory mcp run server.py"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
