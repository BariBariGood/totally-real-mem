# Copy this file to mcp/.env and fill in real values.
# Loaded automatically by mcp/server.py at startup.

# --- CalcCo Express API ---
# Base URL of the CalcCo Express server (no trailing slash).
CALCCO_API_URL=http://localhost:3000
# Per-request timeout against the Express API, in seconds.
CALCCO_HTTP_TIMEOUT_SECONDS=20

# --- Engram MCP SDK ---
# Organization API key. Required for engram_learn / engram_recall.
ENGRAM_API_KEY=
# Base URL of engram-server (no trailing slash). Defaults to http://localhost:8000.
ENGRAM_SERVER_URL=http://localhost:8000
